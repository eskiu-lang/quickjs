+
+/* Frees the pending exception and the pending jobs without running them, the
+   first steps of JS_FreeRuntime, so that an embedder can count the objects still
+   alive before freeing the runtime. */
+void JS_DropPendingJobs(JSRuntime *rt)
+{
+    struct list_head *el, *el1;
+    int i;
+
+    JS_FreeValueRT(rt, rt->current_exception);
+    rt->current_exception = JS_NULL;
+
+    list_for_each_safe(el, el1, &rt->job_list) {
+        JSJobEntry *e = list_entry(el, JSJobEntry, link);
+        for(i = 0; i < e->argc; i++)
+            JS_FreeValueRT(rt, e->argv[i]);
+        js_free_rt(rt, e);
+    }
+    init_list_head(&rt->job_list);
 }
 
